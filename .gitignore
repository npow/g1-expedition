# This workspace contains several unrelated projects and multi-gigabyte local
# training environments.  The Icefall G1 repository is deliberately curated.
/*

# Repository metadata and documentation.
!/.gitignore
!/.gitattributes
!/README.md
!/HANDOFF.md
!/FIXED_LINE.md
!/GETUP.md
!/requirements.txt
!/submission/
!/submission/**
/submission/build/
/submission/node_modules/

# Learned self-arrest implementation.
!/himalaya_env.py
!/diverse_scenarios.py
!/train.py
!/evaluate_diverse_policy.py
!/record_diverse_scenarios.py
!/evaluate_policy.py
!/record_demo.py
!/fixed_line_env.py
!/fixed_line_slope_env.py
!/fixed_line_visuals.py
!/train_fixed_line.py
!/evaluate_fixed_line.py
!/record_fixed_line.py
!/record_fixed_line_learning.py
!/getup_controller.py
!/evaluate_getup.py
!/record_getup.py
!/mountain_recovery.py
!/train_mountain_recovery.py
!/evaluate_mountain_recovery.py
!/record_fixed_line_recovery.py

# Supporting generation and fixed-line validation tools.
!/scripts/
/scripts/*
!/scripts/download_g1_assets.py
!/scripts/find_axe_quat.py
!/scripts/generate_ice_axe.py
!/scripts/hf_train_fixed_line_job.py
!/scripts/render_preview_frames.py
!/scripts/test_hand_grasp.py
!/scripts/test_visual.py
!/scripts/validate_fixed_line_grasp.py
!/scripts/fetch_getup_assets.py

# Pinned get-up policy attribution/license. Binary policy and clip are fetched
# with verified digests instead of being duplicated in Git.
!/third_party/
/third_party/*
!/third_party/wbc_g1_getup/
/third_party/wbc_g1_getup/*
!/third_party/wbc_g1_getup/README.md
!/third_party/wbc_g1_getup/LICENSE

# Simulation assets and third-party Unitree model/license.
!/assets/
!/assets/**

# Only canonical and archived fall-line policy artifacts.
!/models/
/models/*
!/models/ppo_self_arrest/
!/models/ppo_self_arrest/**
!/models/ppo_self_arrest_fall_line_v1/
!/models/ppo_self_arrest_fall_line_v1/**
!/models/ppo_fixed_line_slope/
!/models/ppo_fixed_line_slope/**
!/models/wbc_getup/
!/models/wbc_getup/evaluation_report.json
!/models/ppo_mountain_recovery/
!/models/ppo_mountain_recovery/best/
!/models/ppo_mountain_recovery/best/best_model.zip
!/models/ppo_mountain_recovery/g1_mountain_recovery_final.zip
!/models/ppo_mountain_recovery/training_metadata.json
!/models/ppo_mountain_recovery/evaluation_report.json

# Final evidence media only.
!/videos/
/videos/*
!/videos/g1_self_arrest_diverse_suite.mp4
!/videos/g1_self_arrest_diverse_suite.json
!/videos/diverse_suite_inspection_montage.jpg
!/videos/g1_fixed_line_mountain_v2.mp4
!/videos/g1_fixed_line_mountain_v2.json
!/videos/g1_fixed_line_learned.mp4
!/videos/g1_fixed_line_learned.json
!/videos/g1_fixed_line_learning_progress.mp4
!/videos/g1_fixed_line_learning_progress.json
!/videos/g1_physical_getup.mp4
!/videos/g1_physical_getup.json
!/videos/g1_fixed_line_fall_recovery.mp4
!/videos/g1_fixed_line_fall_recovery.json

# Independent Isaac Lab cooperative-rescue scenario. Keep compact selected
# artifacts, but not redundant raw Hugging Face job bundles or caches.
!/cooperative_beam_isaaclab/
!/cooperative_beam_isaaclab/**
/cooperative_beam_isaaclab/hf_job_outputs/
/cooperative_beam_isaaclab/.pytest_cache/
/cooperative_beam_isaaclab/.ruff_cache/
/cooperative_beam_isaaclab/src/*.egg-info/

# Independent MuJoCo coordinated-lift scenario.
!/mountain-robotics/
!/mountain-robotics/**

# Never commit generated/runtime state if the whitelist expands later.
**/.venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
/logs/
/runs/
*.tmp
*.log

# Stage 2: induced slip / recovery, voice control, and evidence tooling.
# NOTE this file is a WHITELIST -- `/*` ignores everything at root and each
# path is re-admitted explicitly, so a new module is invisible to git until
# listed here.
!/slip_recovery_env.py
!/evaluate_slip_recovery.py
!/train_slip_recovery.py
!/record_slip_recovery.py
!/demo_live.py
!/sim_bridge.py
!/voice_agent.py
!/SLIP_RECOVERY.md
!/HANDOFF_STAGE2.md
!/scripts/generate_rope_visual.py
!/scripts/add_backpack.py
!/docs/
!/docs/**
